fn @tensor.dot_f32(left: Array<f32,1>, right: Array<f32,1>) -> f32 {
    let mut sum = 0.0f32;
    for i in 0i64..len(left) {
        sum = sum + left[i] * right[i];
    }
    return sum;
}

fn @app.main() -> i32 {
    let left: Array<f32,1> = [1.0f32, 2.0f32, 3.0f32];
    let right: Array<f32,1> = [4.0f32, 5.0f32, 6.0f32];
    let score = @tensor.dot_f32(left, right);
    print(score);
    return 0i32;
}
